JWT_SECRET=cambia-este-secreto
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu-clave
DB_NAME=royalbet
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# 🔐 Token interno para los endpoints de dinero del motor de poker:
#   - /api/poker/internal/process-rake  (rake → referidos + fondo del proyecto)
#   - /api/poker/internal/cash-out      (cash-out al levantarse de la mesa)
# El backend (3000) y el pokerServer (3001) leen este MISMO .env.
# En producción usa un valor largo y aleatorio, ej:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=cambia-este-token-interno
