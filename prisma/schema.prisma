generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Oferta publicada por el dueño de la web (administrador).
// Junto con los productos de las mini tiendas forma el catálogo.
// La web arranca con ofertas de bienvenida sembradas
// automáticamente (ver src/lib/seed.ts) para que nunca se vea vacía.
model Offer {
  id          String   @id @default(cuid())
  title       String // nombre del producto o servicio
  description String   @default("")
  category    String   @default("Electrónica")
  price       Float // precio en dinero real ($)
  priceCoins  Int      @default(0) // precio en monedas internas (0 = se calcula con la tasa)
  oldPrice    Float? // precio anterior opcional (para mostrar descuento)
  photo       String? // foto subida o foto elegida de la galería de la tienda
  stock       Int      @default(20) // unidades a la venta (0 = agotado)
  sold        Int      @default(0) // unidades vendidas (almacén)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Ajustes globales del sitio (los controla el administrador)
model SiteSettings {
  id                String   @id @default("main")
  miniStoresEnabled Boolean  @default(true)
  coinRate          Int      @default(100) // cuántas monedas vale 1 CUP real
  catalogSeeded     Boolean  @default(false) // ya se publicaron las ofertas iniciales de bienvenida
  courierFee        Int      @default(200) // CUP que gana el mensajero por entregar una oferta de la web
  updatedAt         DateTime @updatedAt
}

// Cuenta registrada de Violetero. Como en Amazon: cualquiera
// puede mirar ofertas y mini tiendas SIN cuenta, pero para
// comprar hay que registrarse e iniciar sesión.
model User {
  id                   String    @id @default(cuid())
  name                 String    @unique
  password             String // hash con sal (scrypt), nunca se guarda el texto plano
  role                 String    @default("comprador") // comprador | repartidor | administrador
  email                String? @unique // correo electrónico del usuario (para códigos y avisos)
  emailVerifiedAt      DateTime? // cuándo se verificó el correo con un código
  phone                String? @unique // número de teléfono (para códigos por SMS)
  phoneVerifiedAt      DateTime? // cuándo se verificó el teléfono con un código
  telegramChatId       String? // chat de Telegram enlazado (plan B si el SMS no llega)
  telegramUsername     String?
  telegramLinkedAt     DateTime?
  failedLoginAttempts  Int       @default(0) // intentos fallidos seguidos (bloqueo anti-ataques)
  lockedUntil          DateTime? // cuenta bloqueada hasta (por demasiados intentos)
  lastPasswordChangeAt DateTime? // última vez que se cambió la contraseña
  createdAt            DateTime  @default(now())
  sessions             UserSession[]
  codes                VerificationCode[]
}

// Código de verificación de 6 dígitos (restablecer contraseña,
// verificar correo/teléfono, enlazar Telegram). Se guarda solo
// el hash, caduca a los 10 minutos y permite 5 intentos.
model VerificationCode {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose              String // reset_password | verify_email | verify_phone | link_telegram
  codeHash             String // SHA-256 del código de 6 dígitos
  channel              String // email | sms | telegram
  target               String // a quién se envió (correo/teléfono/chat enmascarado)
  attempts             Int       @default(0)
  expiresAt            DateTime
  usedAt               DateTime?
  resetTokenHash       String? // token temporal tras validar el código (para fijar la nueva contraseña)
  resetTokenExpiresAt  DateTime?
  createdAt            DateTime  @default(now())
}

// Sesión iniciada en un dispositivo/c navegador. Permite ver
// y cerrar sesiones activas desde los ajustes (multi-sesión).
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // SHA-256 del token de la cookie (nunca el token en claro)
  device     String // descripción del navegador/dispositivo
  ip         String    @default("")
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime? // si está marcada, la sesión quedó cerrada
}

// Registro de seguridad: inicios de sesión, intentos fallidos,
// bloqueos, cambios de contraseña… para detectar ataques.
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  userName  String   @default("") // nombre en texto (aunque se borre la cuenta)
  type      String // login_ok | login_failed | account_locked | password_reset | password_changed | session_revoked | telegram_linked | attack_blocked | ...
  detail    String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())
}

// Bandeja de salida: cada mensaje que el sistema intenta enviar
// (correo, SMS o Telegram) queda registrado aquí para auditoría.
model OutboxMessage {
  id        String    @id @default(cuid())
  channel   String // email | sms | telegram
  target    String // destinatario (enmascarado)
  subject   String    @default("")
  body      String
  status    String    @default("queued") // queued | sent | failed | simulated
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?
}

// Configuración del sistema guardada en la base (token del bot
// de Telegram, etc.). La controla el administrador.
model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Mini tienda creada por un usuario vendedor
model MiniStore {
  id              String       @id @default(cuid())
  name            String
  ownerName       String
  description     String
  category        String
  emoji           String       @default("🏪")
  logo            String? // foto/logotipo de la tienda (data URL)
  color           String       @default("#5B21B6") // color de marca para el diseño
  trialEndsAt     DateTime     @default(now()) // fin de la prueba gratis (5 días desde la creación)
  subscribedUntil DateTime? // hasta cuándo pagó la suscripción mensual (200 CUP)
  courierFee      Int          @default(200) // CUP que gana el mensajero por una entrega de esta tienda
  createdAt       DateTime     @default(now())
  products        MiniProduct[]
  jobOffers       JobOffer[]
}

// Producto que vende una mini tienda
model MiniProduct {
  id          String    @id @default(cuid())
  storeId     String
  store       MiniStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  price       Float // precio en dinero real (CUP)
  oldPrice    Float? // precio anterior (se guarda solo al cambiar el precio)
  priceCoins  Int       @default(0) // precio en monedas internas
  emoji       String    @default("📦")
  photo       String? // foto del producto (data URL)
  stock       Int       @default(20) // unidades a la venta (0 = agotado)
  sold        Int       @default(0) // unidades vendidas (almacén)
  createdAt   DateTime  @default(now())
}

// Oferta de trabajo de domicilio publicada por una mini tienda
model JobOffer {
  id          String        @id @default(cuid())
  storeId     String
  store       MiniStore     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  zone        String
  payment     Float
  description String
  open        Boolean       @default(true)
  createdAt   DateTime      @default(now())
  applications Application[]
}

// Postulación de un repartidor a una oferta
model Application {
  id            String   @id @default(cuid())
  jobId         String
  job           JobOffer @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantName String
  phone         String
  email         String
  vehicle       String
  message       String   @default("")
  status        String   @default("pending") // pending | accepted | rejected
  createdAt     DateTime @default(now())
}

// Pedido de compra con punto de entrega en el mini mapa
model Order {
  id            String   @id @default(cuid())
  code          String   @unique
  buyerName     String
  address       String
  notes         String?
  mapX          Float
  mapY          Float
  items         String // JSON: [{name, price, qty, store}]
  total         Float
  totalCoins    Int? // total en monedas si el pago fue con billetera
  paymentMethod String   @default("cash") // cash | coins | transfer
  transferId    String? // ID de la transferencia si el pago fue por transferencia
  deliveryMode  String   @default("normal") // normal (repartidor de la tienda) | turbo (público, el primero que lo coge)
  courierFee    Float    @default(0) // CUP que gana el mensajero por esta entrega
  storeIds      String   @default("") // tiendas involucradas (separadas por coma) para el reparto por tienda
  settled       Boolean  @default(false) // liquidación: el mensajero ya entregó el dinero cobrado
  settledAt     DateTime?
  etaMinutes    Int
  status        String   @default("placed") // placed | in_delivery | delivered
  workerName    String?
  createdAt     DateTime @default(now())
}

// Notificaciones del mini correo interno
model Notification {
  id        String   @id @default(cuid())
  toName    String
  title     String
  body      String
  kind      String   @default("sistema") // pedido | trabajo | tienda | recarga | sistema
  orderId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Billetera de monedas internas de cada usuario
model Wallet {
  id        String   @id @default(cuid())
  ownerName String   @unique
  coins     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Solicitud de recarga de saldo (transferencia real -> monedas)
model TopUpRequest {
  id          String    @id @default(cuid())
  userName    String
  methodName  String // método de cobro usado
  amountCash  Float // dinero real enviado
  coins       Int // monedas que se acreditarán
  transferId  String // ID de la transferencia que pone el usuario
  status      String    @default("pending") // pending | approved | rejected
  adminNote   String?
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
}

// Cuenta/tarjeta donde el administrador recibe las transferencias reales
model PaymentMethod {
  id           String  @id @default(cuid())
  label        String // ej: "Tarjeta monetaria BPA"
  details      String // número de tarjeta o cuenta
  holder       String // titular de la cuenta
  phone        String  @default("") // teléfono del titular para las transferencias
  instructions String  @default("")
  active       Boolean @default(true)
}
