   Acento del módulo: 🟣 Púrpura (#8b5cf6)
   FIX v3.0:
     - Patrón fleetDealer aplicado (panel glassmorphism)
     - Inputs con radius 8px + focus translateY
     - Botón con radius 8px + hover translateY
     - Wrapper padding 15px
     - IDs, names, action y Smarty intactos
   ═══════════════════════════════════════════════ *}

<style>
/* ====== Variables globales ====== */
:root {
    --bg-dark:       rgba(11, 16, 30, 0.55);
    --bg-card:       rgba(15, 23, 42, 0.75);
    --bg-card-solid: rgba(15, 23, 42, 0.85);
    --bg-inner:      rgba(0, 0, 0, 0.35);
    --border-color:  #1e293b;
    --text-main:     #cbd5e1;
    --text-muted:    #94a3b8;
    --text-title:    #ffffff;
    --accent-blue:   #3b82f6;
    --accent-cyan:   #00e0ff;
    --accent-purple: #8b5cf6;
    --accent-gold:   #fbbf24;
    --accent-green:  #4aff88;
    --accent-red:    #ef4444;
}

.astroalc_wrap {
    text-align: center;
    padding: 15px;
    box-sizing: border-box;
}

.astroalc_panel {
    display: inline-block;
    text-align: left;
    width: 600px;
    max-width: 100%;
    background: var(--bg-card);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    padding: 15px;
    font-size: 11px;
    color: var(--text-main);
}

.astroalc_title {
    text-transform: uppercase;
    color: var(--accent-purple);
    font-size: 11.5px;
    letter-spacing: 1px;
    border-bottom: 1px solid rgba(139, 92, 246, 0.25);
    padding-bottom: 6px;
    margin-bottom: 12px;
    text-shadow: 0 0 8px rgba(139, 92, 246, 0.4);
}

.astroalc_table {
    width: 100%;
    border-collapse: collapse;
    font-size: 10.5px;
}

.astroalc_table tr > td {
    padding: 8px 10px;
    vertical-align: middle;
    color: var(--text-main);
    border-bottom: 1px solid rgba(30, 41, 59, 0.6);
}

.astroalc_table tr > td:first-child {
    width: 50%;
    color: var(--text-muted);
    font-weight: 600;
}

.astroalc_table tr > td:last-child {
    width: 50%;
}

.astroalc_table input[type="text"] {
    background: rgba(0, 0, 0, 0.5);
    color: #ffffff;
    border: 1px solid rgba(0, 204, 255, 0.35);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 11px;
    font-family: 'Courier New', monospace;
    font-weight: 700;
    width: 100%;
    box-sizing: border-box;
    transition: 0.25s ease;
    outline: none;
}
.astroalc_table input[type="text"]:focus {
    border-color: #00ccff;
    box-shadow: 0 0 12px rgba(0, 224, 255, 0.5);
    background: rgba(0, 0, 0, 0.65);
    transform: translateY(-1px);
}

.astroalc_submit {
    display: inline-block;
    padding: 8px 26px;
    background: linear-gradient(135deg, rgba(0, 102, 204, 0.9), rgba(0, 153, 255, 0.9));
    color: #ffffff;
    border: 1px solid #00ccff;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.25s ease;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-family: inherit;
}
.astroalc_submit:hover {
    background: linear-gradient(135deg, rgba(0, 153, 255, 0.95), rgba(0, 204, 255, 0.95));
    box-shadow: 0 0 14px rgba(0, 224, 255, 0.6);
    transform: translateY(-2px);
}
.astroalc_submit:active {
    transform: translateY(0);
}

.astroalc_center {
    text-align: center;
    padding-top: 10px;
    border-bottom: none !important;
}

@media (max-width: 480px) {
    .astroalc_wrap { padding: 10px; }
    .astroalc_panel { padding: 12px; }
    .astroalc_table tr > td:first-child { width: 40%; }
    .astroalc_table tr > td:last-child  { width: 60%; }
}
</style>

<div class="astroalc_wrap">
<div class="astroalc_panel">

    <div class="astroalc_title">{$LNG.al_make_alliance}</div>

    <form action="game.php?page=alliance&amp;mode=create&amp;action=send" method="POST">
        <table class="astroalc_table">
            <tr>
                <td>{$LNG.al_make_ally_tag_required}</td>
                <td><input type="text" name="atag" size="8" maxlength="8" value=""></td>
            </tr>
            <tr>
                <td>{$LNG.al_make_ally_name_required}</td>
                <td><input type="text" name="aname" size="20" maxlength="30" value=""></td>
            </tr>
            <tr>
                <td colspan="2" class="astroalc_center">
                    <input class="astroalc_submit" type="submit" value="{$LNG.al_make_submit}">
                </td>
            </tr>
        </table>
    </form>

</div>
</div>

{/block}