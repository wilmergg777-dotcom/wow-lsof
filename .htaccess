# ============================================================
# Violetero — reglas para Apache (la mayoría de los VPS y cPanel)
# ============================================================

# Cabeceras de seguridad
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

# Nunca servir archivos sensibles
<FilesMatch "\.(sqlite|db|log)$">
    Require all denied
</FilesMatch>

# El código interno no se sirve directamente
<IfModule mod_rewrite.c>
    RewriteRule ^includes/ - [F,L]
</IfModule>

# Bloquear PHP dentro de uploads (solo imágenes)
<Directory "uploads">
    <FilesMatch "\.(php|phtml|php\d)$">
        Require all denied
    </FilesMatch>
</Directory>

# Página de inicio
DirectoryIndex index.php index.html
