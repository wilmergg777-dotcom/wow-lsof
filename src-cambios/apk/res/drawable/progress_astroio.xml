<?xml version="1.0" encoding="utf-8"?>
<!--
  AstroIO — Barra de progreso de la pantalla de carga (v2.4.5).
  IGUAL que la del launcher de PC: pista oscura redondeada y relleno
  con degradado cian -> azul (#00E0FF -> #0080FF).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="@color/astro_bg" />
            <stroke android:width="1dp" android:color="@color/astro_border" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="7dp" />
                <gradient
                    android:angle="0"
                    android:startColor="@color/astro_accent"
                    android:endColor="#0080FF" />
            </shape>
        </clip>
    </item>
</layer-list>
