; Engine configuration file.
; Aethelgard — cliente Godot 4 del MMO WoW-like.
;
; Multiplataforma: Android, Windows, Linux, macOS. Sin web.
;
; Para abrir el proyecto:
;   1. Instala Godot 4.x (https://godotengine.org/download)
;   2. Abre Godot → Import → selecciona este archivo project.godot.
;   3. F5 para correr (escena inicial: pantalla_login.tscn).

config_version=5

[application]

config/name="Aethelgard"
config/description="Cliente del MMO Aethelgard (WoW-like, multiplataforma)."
run/main_scene="res://escenas/pantalla_login.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Red="*res://guiones/red.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

